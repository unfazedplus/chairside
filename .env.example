# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role bypasses Row Level Security. Server-side only. Never expose to
# the browser and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Local development (npx supabase start) ----
# When running the local stack these replace the values above:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<printed by `npx supabase status`>
# SUPABASE_SERVICE_ROLE_KEY=<printed by `npx supabase status`>
